{
  "name": "elastalert2-server",
  "version": "5.24.0",
  "description": "A server that runs ElastAlert2 and exposes REST API's for manipulating rules and alerts.",
  "license": "MIT",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karql/elastalert2-server.git"
  },
  "directories": {
    "lib": "./lib",
    "test": "./test"
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.6",
    "elasticsearch": "^16.7.3",
    "express": "^4.22.1",
    "joi": "^18.3.2",
    "lodash": "^4.18.1",
    "mkdirp": "^3.0.1",
    "randomstring": "^1.3.2",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tsoa/cli": "^6.6.0",
    "@types/bunyan": "^1.8.11",
    "@types/cors": "^2.8.19",
    "@types/elasticsearch": "^5.0.43",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/randomstring": "^1.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "ts-deepmerge": "^8.0.0",
    "@tsoa/cli": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.7"
    },
    "nodemon": {
      "minimatch": "^11.0.7"
    }
  },
  "scripts": {
    "dev": "concurrently \"nodemon\" \"nodemon --config nodemon-spec.json\"",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node dist/index.js",
    "serve": "nodemon --inspect --watch dist/ -d 1 ./dist/index.js",
    "tsc:watch": "tsc -w",
    "tsc:build": "tsc"
  }
}
