{
  "name": "elastalert2-server",
  "version": "5.24.0",
  "description": "A server that runs ElastAlert2 and exposes REST API's for manipulating rules and alerts.",
  "license": "MIT",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karql/elastalert2-server.git"
  },
  "directories": {
    "lib": "./lib",
    "test": "./test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "bunyan": "^1.8.15",
    "elasticsearch": "^16.7.3",
    "hono": "^4.13.18",
    "mkdirp": "^3.0.1",
    "randomstring": "^1.3.2",
    "swagger-ui-dist": "^5.34.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.11",
    "@types/elasticsearch": "^5.0.43",
    "@types/node": "^26.6.6",
    "@types/randomstring": "^1.3.0",
    "@types/ws": "^8.18.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "nodemon": {
      "minimatch": "^11.0.7"
    }
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "serve": "nodemon --inspect --watch dist/ -d 1 ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "tsc:watch": "tsc -w"
  }
}
